2. \tab Miejscem wykonania us\'b3ugi dostarczenia wody jest pierwszy zaw\'f3r za wodomierzem g\'b3\'f3wnym zamontowanym w (\i budynku / studzience / inne miejsce\i0 )\b  [PA-parametr_3]\b0\par
3. \tab Odbiorca us\'b3ug o\'9cwiadcza, \'bfe przygotowane pomieszczenie, w kt\'f3rym jest zainstalowany wodomierz g\'b3\'f3wny jest zabezpieczone przed zalaniem wod\'b9, zamarzaniem oraz dost\'eapem os\'f3b niepowo\'b3anych.\par
4. \tab Odbiorca us\'b3ug o\'9cwiadcza, \'bfe jest [PA-parametr_5],................................ (\i posiadany tytu\'b3 prawny do nieruchomo\'9cci\i0 ) nieruchomo\'9cci, o kt\'f3rej mowa w \'a7 1 ust. 1 i ust. 4 umowy.\par
\cf1\ul\tab\cf0\ulnone\b\f1\lang1033                                    \cf1\ul\b0\f0\lang1045\'a7 2. Zakres odpowiedzialno\'9cci\cf0\ulnone\par

\pard\nowidctlpar\li-50 Dostawca us\'b3ug ma obowi\'b9zek zapewni\'e6 zdolno\'9c\'e6 posiadanych przy\'b3\'b9czy oraz urz\'b9dze\'f1 wodoci\'b9gowych do prawid\'b3owej realizacji us\'b3ugi zaopatrzenia w wod\'ea natomiast odbiorca us\'b3ug odpowiada za zapewnienie niezawodnego dzia\'b3ania posiadanych instalacji i przy\'b3\'b9czy wodoci\'b9gowych.\par

\pard\nowidctlpar\li-50\tx491\cf1\ul\tab\cf0\ulnone\b\f1\lang1033                                      \cf1\ul\b0\f0\lang1045\'a7 3 O\'9cwiadczenia stron\par
\cf0\ulnone 1. \tab Odbiorca us\'b3ug o\'9cwiadcza, \'bfe woda dostarczana przez Przedsi\'eabiorstwo b\'eadzie wykorzystywana na cele: \par
\tab 1). Socjalno-bytowe - w ilo\'9cci ok\b . [PA-parametr_1]\b0  m\super 3  \nosupersub miesi\'eacznie\par
\tab 2). Na potrzeby produkcji, w kt\'f3rej woda wchodzi w sk\'b3ad albo bezpo\'9credni kontakt z produktami \'bfywno\'9cciowymi i farmaceutycznymi lub na cele konfekcjonowania - w ilo\'9cci ok. \b xxx \b0 m\super 3 \nosupersub miesi\'eacznie\par
2. \tab Odbiorca us\'b3ug o\'9cwiadcza, \'bfe przygotowane pomieszczenie, w kt\'f3rym jest zainstalowany wodomierz g\'b3\'f3wny jest zabezpieczone przed zalaniem wod\'b9, zamarzaniem oraz dost\'eapem os\'f3b niepowo\'b3anych.\par
3. \tab Dostarczanie wody do innych cel\'f3w ni\'bf zadeklarowane w ust. 1, wymaga zmiany umowy.\par
4. \tab Dostawca us\'b3ug o\'9cwiadcza, \'bfe zobowi\'b9zuje si\'ea do zapewnienia zdolno\'9cci posiadanych urz\'b9dze\'f1 wodoci\'b9gowych do realizacji dostaw wody w ilo\'9cci \b [PA-parametr_1]\b0  m\super 3\nosupersub  na miesi\'b9c i pod minimalnym ci\'9cnieniem 0,5 Bara na zaworze za wodomierzem g\'b3\'f3wnym.\par
5. \tab Dostawca us\'b3ug o\'9cwiadcza, \'bfe zobowi\'b9zuje si\'ea do zapewnienia dostawy wody o jako\'9cci przeznaczonej do spo\'bfycia przez ludzi i o parametrach nieprzekraczaj\'b9cych wymienionych warto\'9cci: \'bfelazo: 0,2 mg Fe/l; mangan: 0,05 mg Mn/l; jon amonowy: 0,05 mg NH4+/l; azotany: 0,05 mg NO3-/l; azotyny: 0,05 mg NO2-/l: fluorki 1,50 mg F/l; barwa: akceptowalna bez nieprawid\'b3owych zmian; m\'eatno\'9c\'e6: 1 NTU; pH: 6,5 - 9,5;, w ilo\'9cci \animtext5 [\b PA-parametr_1]\b0  m\super 3 \nosupersub na miesi\'b9c\animtext0 .\par
6. \tab Dostawca zakupi, zainstaluje i utrzyma na w\'b3asny koszt wodomierz g\'b3\'f3wny w pomieszczeniu przygotowanym przez Odbiorc\'ea us\'b3ug. Wodomierz g\'b3\'f3wny stanowi w\'b3asno\'9c\'e6 Przedsi\'eabiorstwa.\par
