\pard\intbl\brdrl\brdrs\brdrw20\brdrcf1 \brdrt\brdrs\brdrw20\brdrcf1 \brdrr\brdrs\brdrw20\brdrcf1 \brdrb\brdrs\brdrw20\brdrcf1 20.\cell\cf1 Przy przej\'9cciu przy\'b3\'b9cza pod \'b3aw\'b9 fundamentow\'b9 zaleca si\'ea zachowa\'e6 odleg\'b3o\'9c\'e6 mi\'f1 1,5m od naro\'bfnika budynku.\cf0\cell\row\trowd\trgaph70\trleft-142\trbrdrl\brdrs\brdrw20\brdrcf1 \trbrdrt\brdrs\brdrw20\brdrcf1 \trbrdrr\brdrs\brdrw20\brdrcf1 \trbrdrb\brdrs\brdrw20\brdrcf1 \trpaddl70\trpaddr70\trpaddfl3\trpaddfr3
\clbrdrl\brdrw15\brdrs\clbrdrt\brdrw15\brdrs\clbrdrr\brdrw15\brdrs\clbrdrb\brdrw15\brdrs \cellx459\clbrdrl\brdrw15\brdrs\clbrdrt\brdrw15\brdrs\clbrdrr\brdrw15\brdrs\clbrdrb\brdrw15\brdrs \cellx10788 
\pard\intbl\brdrl\brdrs\brdrw20\brdrcf1 \brdrt\brdrs\brdrw20\brdrcf1 \brdrr\brdrs\brdrw20\brdrcf1 \brdrb\brdrs\brdrw20\brdrcf1 21.\cell Nie nale\'bfy wykonywa\'e6 przy\'b3\'b9czy wodoci\'b9gowych pod wjazdami, bramami, wzd\'b3u\'bf p\'b3ot\'f3w, s\'b3upami ogrodzeniowymi, o\'9cwietleniowymi, istniej\'b9cymi budynkami gospodarczymi, gara\'bfowymi itp.\cell\row\trowd\trgaph70\trleft-142\trbrdrl\brdrs\brdrw20\brdrcf1 \trbrdrt\brdrs\brdrw20\brdrcf1 \trbrdrr\brdrs\brdrw20\brdrcf1 \trbrdrb\brdrs\brdrw20\brdrcf1 \trpaddl70\trpaddr70\trpaddfl3\trpaddfr3
\clbrdrl\brdrw15\brdrs\clbrdrt\brdrw15\brdrs\clbrdrr\brdrw15\brdrs\clbrdrb\brdrw15\brdrs \cellx459\clbrdrl\brdrw15\brdrs\clbrdrt\brdrw15\brdrs\clbrdrr\brdrw15\brdrs\clbrdrb\brdrw15\brdrs \cellx10788 
\pard\intbl\brdrl\brdrs\brdrw20\brdrcf1 \brdrt\brdrs\brdrw20\brdrcf1 \brdrr\brdrs\brdrw20\brdrcf1 \brdrb\brdrs\brdrw20\brdrcf1 22.\cell W\'b3\'b9czenie przy\'b3\'b9cza do istniej\'b9cego wodoci\'b9gu wykonanego z rur PE wykona\'e6 na obejm\'ea do nawiercania ze zgrzewalnym, obrotowym (360 st.) odej\'9cciem PE100 SDR11 z doln\'b9 cz\'ea\'9cci\'b9 monta\'bfow\'b9 i zintegrowanym frezem do nawiercania pod ci\'9cnieniem. W przypadku przy\'b3\'b9cza dla budynku o wi\'eakszym przep\'b3ywie obliczeniowym ni\'bf dla budynku jednorodzinnego (hali produkcyjnej, magazynowej itp.) w\'b3\'b9czenie do wodoci\'b9gu nale\'bfy wykona\'e6 na tr\'f3jniki PEHD. W razie niejasno\'9cci nale\'bfy ka\'bfdorazowo zwr\'f3ci\'e6 si\'ea do dzia\'b3u technicznego w celu ustalenia przyj\'eatego rozwi\'b9zania. \cell\row\trowd\trgaph70\trleft-142\trbrdrl\brdrs\brdrw20\brdrcf1 \trbrdrt\brdrs\brdrw20\brdrcf1 \trbrdrr\brdrs\brdrw20\brdrcf1 \trbrdrb\brdrs\brdrw20\brdrcf1 \trpaddl70\trpaddr70\trpaddfl3\trpaddfr3
